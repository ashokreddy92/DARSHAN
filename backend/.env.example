# DarshanEase — Environment Configuration Template
# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB Primary Database
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/darshanease?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Redis Distributed Cache & Rate Limiting
REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=true
REDIS_KEY_PREFIX=darshanease:

# RabbitMQ Message Broker
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_ENABLED=true
RABBITMQ_VHOST=/

# SMTP Transactional Email (Email OTP & Notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM=your_email@gmail.com
# Backward-compatible aliases:
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_gmail_app_password

# Cloudinary Media Storage (Optional)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Payment Gateway Webhook Secret (Optional)
PAYMENT_WEBHOOK_SECRET=your_webhook_secret_here
